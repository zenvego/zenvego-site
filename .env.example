# Copy this file to .env.local and fill in the value.

# Web3Forms access key — delivers contact-form submissions to your inbox.
# Sign up free at https://web3forms.com with the email you want submissions sent to,
# then paste the access key here. Safe to expose client-side (NEXT_PUBLIC_*):
# the key can only deliver to the email address you registered it with.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
